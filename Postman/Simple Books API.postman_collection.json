    {
      "name": "08_JS_Expect (assertion)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Testr n°1 :\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    });\r",
              "\r",
              "// Test n°2 : \r",
              "pm.test(\"Status = 2xx (positif)\", function () {\r",
              "    pm.expect(pm.response.code).to.be.within(200, 299);\r",
              "    });\r",
              "// Testr n°3 :\r",
              "const limit = 250 // Valeur limite de temps de réponse.\r",
              "pm.test(`Response time is less than ${limit}`, function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(limit);\r",
              "});\r",
              "\r",
              "const responseBody = pm.response.json();\r",
              "// Test n°4\r",
              "pm.test(\"Elément Status est présent\", function () {\r",
              "    pm.expect(responseBody).to.have.property('status');\r",
              "});\r",
              "\r",
              "// Test n°5\r",
              "\r",
              "pm.test(\"La valeur du  Status dans la réponse\", function () {\r",
              "    pm.expect(responseBody.status).to.equal('OK');\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
